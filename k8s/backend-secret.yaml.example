# Copy to backend-secret.yaml, fill in real values, and DO NOT commit the real file.
# Apply with: kubectl apply -f k8s/backend-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: wordbox-backend-secret
  namespace: wordbox
type: Opaque
stringData:
  AZURE_STORAGE_CONNECTION_STRING: "DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"
